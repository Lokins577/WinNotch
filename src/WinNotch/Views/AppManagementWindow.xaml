<Window x:Class="WinNotch.Views.AppManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Management" Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Application &amp; Package Management" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Ctrl+Alt+G · all mutations require review" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Updates">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button Content="Discover WinGet upgrades" Click="OnDiscoverUpgrades" HorizontalAlignment="Left" Padding="10,5"/>
                    <ListBox x:Name="UpgradeList" Grid.Row="1" DisplayMemberPath="Display" Margin="0,8"/>
                    <Button Grid.Row="2" Content="Review and upgrade selected…" Click="OnUpgrade" HorizontalAlignment="Left" Padding="10,5"/>
                </Grid>
            </TabItem>
            <TabItem Header="Installed apps">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel><Button Content="Refresh installed apps" Click="OnRefreshInstalled" Padding="10,5"/><Button Content="Run installer…" Click="OnInstaller" Padding="10,5" Margin="8,0,0,0"/></WrapPanel>
                    <ListBox x:Name="InstalledList" Grid.Row="1" DisplayMemberPath="Display" Margin="0,8"/>
                    <Button Grid.Row="2" Content="Review selected uninstaller…" Click="OnUninstall" HorizontalAlignment="Left" Padding="10,5"/>
                </Grid>
            </TabItem>
            <TabItem Header="Cleanup">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <WrapPanel><TextBlock Text="Temporary minimum age days" VerticalAlignment="Center"/><TextBox x:Name="TempAgeText" Width="55" Margin="8,0,12,0"/><TextBlock Text="Messaging retention days" VerticalAlignment="Center"/><TextBox x:Name="RetentionText" Width="55" Margin="8,0,12,0"/><Button Content="Add messaging folder…" Click="OnAddMessagingFolder" Padding="8,3"/></WrapPanel>
                        <Button Content="Scan without deleting" Click="OnScanCleanup" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="CleanupList" Grid.Row="1" DisplayMemberPath="Display" SelectionMode="Extended" Margin="0,8"/>
                    <Button Grid.Row="2" Content="Review and recycle selected…" Click="OnRecycle" HorizontalAlignment="Left" Padding="10,5"/>
                </Grid>
            </TabItem>
            <TabItem Header="Ports &amp; processes">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button Content="Refresh TCP owners" Click="OnRefreshPorts" HorizontalAlignment="Left" Padding="10,5"/>
                    <ListBox x:Name="PortList" Grid.Row="1" DisplayMemberPath="Display" Margin="0,8"/>
                    <WrapPanel Grid.Row="2"><Button Content="Request close" Click="OnRequestClose" Padding="10,5"/><Button Content="Force terminate…" Click="OnForceTerminate" Padding="10,5" Margin="8,0,0,0"/></WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Window>
