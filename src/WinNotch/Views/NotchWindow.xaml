<Window x:Class="WinNotch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.Views"
        xmlns:comp="clr-namespace:WinNotch.Views.Components"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        Title="WinNotch">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fixed-size window; notch shape animates inside it. No window resizing. -->
    <Grid x:Name="RootGrid">
        <Canvas x:Name="NotchCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">

            <!-- Shadow layer (below the notch) -->
            <Path x:Name="ShadowPath"
                  Fill="{DynamicResource NotchShadowBrush}">
                <Path.Effect>
                    <BlurEffect Radius="12" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Liquid Glass: refracted + vibrancy-boosted backdrop; GPU blur on top.
                 The capture itself already bends content around the rim (edge lens). -->
            <Path x:Name="BackdropBlurPath" Opacity="0" IsHitTestVisible="False">
                <Path.Effect>
                    <BlurEffect Radius="9" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Main notch shape — in liquid glass the fill is a thin ~35% tint -->
            <Path x:Name="NotchPath"
                  Fill="{DynamicResource NotchFillBrush}"
                  Cursor="Hand"/>

            <!-- Liquid Glass: specular pass — bright top rim light falling off fast,
                 a faint mid sheen, and a soft counter-light along the bottom edge -->
            <Path x:Name="GlassSpecularPath" Opacity="0" IsHitTestVisible="False">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#55FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#1AFFFFFF" Offset="0.09"/>
                        <GradientStop Color="#06FFFFFF" Offset="0.28"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.90"/>
                        <GradientStop Color="#20FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Liquid Glass: glass ring — bright where light hits (top-left),
                 dimmer through the middle, softly lit again bottom-right -->
            <Path x:Name="GlassBorderPath" Opacity="0" IsHitTestVisible="False"
                  StrokeThickness="1.4" Fill="{x:Null}">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B4FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#3CFFFFFF" Offset="0.30"/>
                        <GradientStop Color="#1EFFFFFF" Offset="0.60"/>
                        <GradientStop Color="#78FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Liquid Glass: dark inner shadow for depth just inside the ring -->
            <Path x:Name="GlassInnerShadowPath" Opacity="0" IsHitTestVisible="False"
                  StrokeThickness="2.4" Fill="{x:Null}">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#20000000" Offset="0.55"/>
                        <GradientStop Color="#10000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Clip region for content (matches notch shape) -->
            <Grid x:Name="ContentGrid" ClipToBounds="True">
                <!-- Closed state content -->
                <Grid x:Name="ClosedContent" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <views:TimerCompactView x:Name="TimerCompact"/>
                        <views:DownloadCompactView x:Name="DownloadCompact"/>
                        <views:NotificationCompactView x:Name="NotificationCompact"/>
                        <views:AgentCompactView x:Name="AgentCompact"/>
                        <views:ClipboardCompactView x:Name="ClipboardCompact"/>
                        <!-- Plugin closed content -->
                        <StackPanel x:Name="PluginClosedPanel" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <views:MusicLiveActivity x:Name="LiveActivity"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Margin="6,0,2,0"/>
                    <views:ClockWidget x:Name="ClockWidget"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="8,0,2,0"
                                       Visibility="Visible"/>
                    <views:BatteryIndicator x:Name="BatteryIndicator"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>
                    <views:HudOverlay x:Name="HudOverlay"
                                      Grid.ColumnSpan="3"
                                      VerticalAlignment="Center"
                                      Margin="6,0,6,0"/>
                </Grid>

                <!-- Open state content -->
                <Grid x:Name="OpenContent" Opacity="0" Margin="12,6,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Main content (music + calendar) -->
                    <Grid x:Name="MainOpenContent" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <views:MusicPlayerView x:Name="MusicPlayer" Grid.Column="0"/>

                        <!-- Calendar panel -->
                        <StackPanel x:Name="CalendarPanel" Grid.Column="1" Orientation="Horizontal">
                            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="8,4,8,4"/>
                            <views:CalendarView x:Name="CalendarPanel_View"/>
                        </StackPanel>

                        <!-- Plugin accessory content -->
                        <StackPanel x:Name="PluginAccessoryPanel" Grid.Column="2" Orientation="Horizontal"
                                    Visibility="Collapsed"/>

                        <!-- Webcam mirror -->
                        <StackPanel x:Name="WebcamPanel" Grid.Column="3" Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="8,4,8,4"/>
                            <views:WebcamView x:Name="WebcamMirror"/>
                        </StackPanel>

                        <!-- Gear button (right edge, vertically centered) -->
                        <Button x:Name="SettingsGearButton"
                                Grid.Column="4"
                                Click="OnSettingsGearClick"
                                Style="{StaticResource IconButton}"
                                Width="24" Height="24"
                                VerticalAlignment="Top" Margin="4,0,0,0"
                                ToolTip="Settings" AutomationProperties.Name="Settings">
                            <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource TextSubtleBrush}"/>
                        </Button>
                    </Grid>

                    <!-- File shelf (visible when files are shelved) -->
                    <views:ShelfView x:Name="ShelfPanel"
                                     Grid.Row="1"
                                     Visibility="Collapsed"
                                     Margin="0,4,0,0"/>

                    <!-- Timer / focus live activity -->
                    <views:TimerView x:Name="TimerOpenView" Grid.Row="2"
                                     Visibility="Collapsed"/>

                    <views:DownloadActivityView x:Name="DownloadOpenView" Grid.Row="3"
                                                Visibility="Collapsed"/>

                    <views:NotificationActivityView x:Name="NotificationOpenView" Grid.Row="4"
                                                    Visibility="Collapsed"/>

                    <views:AgentActivityView x:Name="AgentOpenView" Grid.Row="5"
                                             Visibility="Collapsed"/>

                    <views:ClipboardHistoryView x:Name="ClipboardOpenView" Grid.Row="6"
                                                Visibility="Collapsed"/>

                    <!-- Plugin open content -->
                    <StackPanel x:Name="PluginOpenPanel" Grid.Row="7"
                                Margin="0,4,0,0"/>

                    <!-- Inline settings (hidden by default, shown when gear clicked) - slides down in top mode -->
                    <views:InlineSettingsView x:Name="InlineSettings"
                                              Grid.Row="8"
                                              Visibility="Collapsed"
                                              Margin="0,6,0,0"/>
                </Grid>

                <!-- Vertical closed content (side dock) -->
                <StackPanel x:Name="VerticalClosedContent" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel x:Name="VerticalPluginClosedPanel"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"/>
                    <TextBlock x:Name="SideTimeSmall" Text="12:00"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <!-- Vertical HUD Overlay for volume/brightness -->
                    <views:HudOverlay x:Name="VerticalHudOverlay"
                                      HorizontalAlignment="Center"
                                      Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Vertical open content (side dock) - expands to the right when settings opened -->
                <Grid x:Name="VerticalOpenContent" Opacity="0" Visibility="Collapsed"
                      ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/> <!-- Main vertical panel - fixed width -->
                        <ColumnDefinition Width="Auto"/>    <!-- Settings panel (visibility-controlled) -->
                    </Grid.ColumnDefinitions>

                    <!-- Main vertical content -->
                    <StackPanel Grid.Column="0" Margin="4,8,4,8" Width="152">
                        <!-- Clock -->
                        <TextBlock x:Name="SideTimeText" Text="12:00"
                                   FontSize="28" FontWeight="Light"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SideDateText" Text="ven. 18"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,14"/>

                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="6,0,6,14"/>

                        <!-- Music -->
                        <StackPanel x:Name="SideMusicPanel" HorizontalAlignment="Center">
                            <Border Width="100" Height="100" CornerRadius="12"
                                    ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,8"
                                    Background="{DynamicResource SegmentedBgBrush}">
                                <Image x:Name="SideAlbumArt" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="SideSongTitle" Text=""
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="130"/>
                            <TextBlock x:Name="SideArtistName" Text=""
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="130"
                                       Margin="0,2,0,6"/>

                            <!-- Progress bar -->
                            <Grid Margin="0,0,0,2" Width="130">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SideElapsedText" Grid.Column="0"
                                           Text="0:00" FontSize="9"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border Grid.Column="1" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource ProgressTrackBrush}"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnSideProgressBarClick">
                                    <Border x:Name="SideProgressFill" Height="3" CornerRadius="1.5"
                                            Background="{DynamicResource ProgressFillBrush}"
                                            HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock x:Name="SideDurationText" Grid.Column="2"
                                           Text="0:00" FontSize="9"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Audio visualizer -->
                            <comp:AudioVisualizer x:Name="SideVisualizer"
                                                  Width="80" Height="24"
                                                  BarCount="5" BarWidth="3" BarGap="2"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,4,0,6"/>

                            <!-- Play controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Click="OnSidePrevClick"
                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                    <TextBlock Text="⏮" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Click="OnSidePlayClick"
                                        Style="{StaticResource IconButton}" Width="32" Height="32"
                                        Margin="12,0">
                                    <TextBlock x:Name="SidePlayIcon" Text="▶" FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                                <Button Click="OnSideNextClick"
                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                    <TextBlock Text="⏭" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <views:TimerView x:Name="VerticalTimerView"
                                         Visibility="Collapsed" Margin="4,10,4,0"/>

                        <views:DownloadActivityView x:Name="VerticalDownloadView"
                                                    Visibility="Collapsed" Margin="4,8,4,0"/>

                        <views:NotificationActivityView x:Name="VerticalNotificationView"
                                                        Visibility="Collapsed" Margin="4,8,4,0"/>

                        <views:AgentActivityView x:Name="VerticalAgentView"
                                                 Visibility="Collapsed" Margin="4,8,4,0"/>

                        <views:ClipboardHistoryView x:Name="VerticalClipboardView"
                                                    Visibility="Collapsed" Margin="4,8,4,0"/>

                        <StackPanel x:Name="VerticalPluginOpenPanel"
                                    Margin="0,14,0,0"/>

                        <!-- Bottom -->
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}"
                                Margin="6,14,6,10"/>

                        <Button Click="OnSideSettingsClick"
                                Style="{StaticResource IconButton}"
                                Width="24" Height="24"
                                HorizontalAlignment="Center" ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                Margin="0,0,0,8">
                            <TextBlock Text="⚙" FontSize="13"
                                       Foreground="{DynamicResource TextSubtleBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Settings panel for vertical mode (expands to the right) -->
                    <Border Grid.Column="1" x:Name="VerticalSettingsPanel"
                            Visibility="Collapsed"
                            Width="280"
                            ClipToBounds="True"
                            Background="{DynamicResource NotchFillBrush}"
                            Margin="0,8,0,8">
                        <views:InlineSettingsView x:Name="VerticalInlineSettings"
                                                  Width="264"
                                                  Margin="8,0,8,0"/>
                    </Border>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
