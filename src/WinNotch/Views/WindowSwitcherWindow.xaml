<Window x:Class="WinNotch.Views.WindowSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wm="clr-namespace:WinNotch.WindowManagement;assembly=WinNotch.Platform.Windows"
        Title="Window Switcher" Width="940" Height="610" MinWidth="780" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Window Switcher" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Ctrl+Alt+W" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="34" Margin="18,0,12,0"
                         Padding="8,5" VerticalAlignment="Center" TextChanged="OnSearchChanged"/>
                <CheckBox x:Name="CurrentDesktopOnlyCheck" Grid.Column="2"
                          Content="Current desktop only" IsChecked="True"
                          VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <Button Grid.Column="3" Content="×" FontSize="18" Width="34" Height="34"
                        Margin="12,0,0,0" Click="OnDismiss"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="WindowList" SelectionChanged="OnWindowSelected"
                         MouseDoubleClick="OnActivate" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text=" · " FontSize="10"
                                               Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding MonitorName}" FontSize="10"
                                               Foreground="{DynamicResource TextDimBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="Black" BorderBrush="{DynamicResource SeparatorBrush}"
                            BorderThickness="1" MinHeight="260">
                        <wm:DwmThumbnailHost x:Name="PreviewHost"/>
                    </Border>

                    <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button Content="Left ½" Tag="LeftHalf" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Right ½" Tag="RightHalf" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Maximize" Tag="Maximize" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Top left" Tag="TopLeft" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Top right" Tag="TopRight" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Bottom left" Tag="BottomLeft" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Bottom right" Tag="BottomRight" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Left ⅓" Tag="LeftThird" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Center ⅓" Tag="CenterThird" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                        <Button Content="Right ⅓" Tag="RightThird" Click="OnApplyLayout" Padding="9,4" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                        <Button Content="Activate" Click="OnActivate" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Previous monitor" Tag="-1" Click="OnMoveMonitor" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Next monitor" Tag="1" Click="OnMoveMonitor" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Restore" Click="OnRestore" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Close window" Click="OnCloseWindow" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Quit app…" Click="OnQuitApplication" Padding="10,5"/>
                    </WrapPanel>
                </Grid>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" FontSize="10"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>
    </Border>
</Window>
