<Window x:Class="WinNotch.Views.MediaQueueSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media queue settings" Width="620" Height="560"
        MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Provider queue adapters" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,16" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Windows media sessions do not expose a universal playback queue. WinNotch reads a queue only from a provider you explicitly enable and configure."/>

                <GroupBox Header="Spotify Web API" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="SpotifyEnabledCheck" Content="Enable Spotify queue lookup"/>
                        <TextBlock Margin="0,8,0,3" Text="Access token"/>
                        <PasswordBox x:Name="SpotifyTokenBox" AutomationProperties.Name="Spotify access token"/>
                        <TextBlock x:Name="SpotifyCredentialStatus" Margin="0,4,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="The token must grant user-read-playback-state and user-read-currently-playing. It is sent only to api.spotify.com and stored with Windows user-bound credential protection. Spotify access tokens expire; replace it when authentication is required."/>
                        <Button Content="Remove saved Spotify token" Click="OnClearSpotify"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="VLC Web interface" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="VlcEnabledCheck" Content="Enable local VLC queue lookup"/>
                        <TextBlock Margin="0,8,0,3" Text="Loopback Web interface URL"/>
                        <TextBox x:Name="VlcUrlText"/>
                        <TextBlock Margin="0,8,0,3" Text="Web interface password"/>
                        <PasswordBox x:Name="VlcPasswordBox" AutomationProperties.Name="VLC Web interface password"/>
                        <TextBlock x:Name="VlcCredentialStatus" Margin="0,4,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Only HTTP(S) loopback addresses are accepted. Redirects are blocked so the password cannot be forwarded away from this PC. Enable VLC's Web interface and set its password first."/>
                        <Button Content="Remove saved VLC password" Click="OnClearVlc"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save and refresh" Click="OnSave" Padding="12,5"/>
                <Button Content="Close" Click="OnClose" Padding="12,5" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
