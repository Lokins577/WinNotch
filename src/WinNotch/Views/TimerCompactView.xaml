<UserControl x:Class="WinNotch.Views.TimerCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
        <Ellipse x:Name="StatusDot" Width="5" Height="5"
                 Fill="{DynamicResource ProgressFillBrush}" Margin="0,0,5,0"/>
        <TextBlock x:Name="TimeText" FontSize="10" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>
</UserControl>
