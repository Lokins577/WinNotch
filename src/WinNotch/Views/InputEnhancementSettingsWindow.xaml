<Window x:Class="WinNotch.Views.InputEnhancementSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Enhancements" Width="700" Height="650" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Input Enhancements" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Ctrl+Alt+I · disabled by default in elevated apps, password fields, and exclusions"
                       TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SCROLL" FontSize="10" FontWeight="SemiBold"/>
                <WrapPanel><CheckBox x:Name="ReverseVerticalCheck" Content="Reverse vertical" Margin="0,6,18,0"/><CheckBox x:Name="ReverseHorizontalCheck" Content="Reverse horizontal" Margin="0,6,0,0"/></WrapPanel>
                <TextBlock Text="Scroll multiplier (0.1–5)" Margin="0,8,0,2"/><TextBox x:Name="ScrollMultiplierText"/>

                <TextBlock Text="FOCUS &amp; MOUSE" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <CheckBox x:Name="FocusCheck" Content="Focus follows mouse after delay" Margin="0,6,0,0"/>
                <TextBlock Text="Focus delay milliseconds" Margin="0,6,0,2"/><TextBox x:Name="FocusDelayText"/>
                <CheckBox x:Name="AccelerationCheck" Content="Temporarily override Windows mouse speed/acceleration while feature runs" Margin="0,8,0,0"/>
                <UniformGrid Columns="4" Margin="0,4,0,0"><StackPanel><TextBlock Text="Speed"/><TextBox x:Name="SpeedText"/></StackPanel><StackPanel Margin="6,0"><TextBlock Text="Threshold 1"/><TextBox x:Name="Threshold1Text"/></StackPanel><StackPanel Margin="6,0"><TextBlock Text="Threshold 2"/><TextBox x:Name="Threshold2Text"/></StackPanel><StackPanel><TextBlock Text="Mode 0–2"/><TextBox x:Name="AccelerationModeText"/></StackPanel></UniformGrid>

                <TextBlock Text="BUTTONS" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="XButton 1"/><ComboBox x:Name="X1Box"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="XButton 2"/><ComboBox x:Name="X2Box"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Right Super key"/><ComboBox x:Name="SuperBox"/></StackPanel></Grid>
                <TextBlock Text="Side-button debounce milliseconds" Margin="0,8,0,2"/><TextBox x:Name="DebounceText"/>

                <TextBlock Text="TEXT EXPANSION" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <CheckBox x:Name="ExpansionCheck" Content="Expand saved snippets after whitespace or punctuation" Margin="0,5,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="SnippetList" DisplayMemberPath="Trigger" SelectionChanged="OnSnippetSelected"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Trigger"/><TextBox x:Name="TriggerText"/><TextBlock Text="Replacement" Margin="0,5,0,0"/><TextBox x:Name="ReplacementText" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><Button Content="New" Click="OnNewSnippet" Padding="8,3"/><Button Content="Save snippet" Click="OnSaveSnippet" Padding="8,3" Margin="6,0,0,0"/><Button Content="Delete" Click="OnDeleteSnippet" Padding="8,3" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid>
                <TextBlock Text="Excluded process names, comma separated" Margin="0,10,0,2"/><TextBox x:Name="ExcludedText"/>
                <TextBlock Text="Limitations: higher-integrity/elevated windows and anti-cheat protected processes may reject hooks or injected input. WinNotch does not attempt bypasses."
                           TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" Padding="12,5"/><Button Content="Save" Click="OnSave" Padding="12,5" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
