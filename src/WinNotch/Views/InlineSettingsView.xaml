<UserControl x:Class="WinNotch.Views.InlineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/ToggleSwitchStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
                <ResourceDictionary Source="Components/SliderStyle.xaml"/>
                <ResourceDictionary Source="Components/SegmentedRadioStyle.xaml"/>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingLabelBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: back arrow + "Settings" title -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="OnBackClick"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        VerticalAlignment="Center" ToolTip="Back" AutomationProperties.Name="Back">
                    <TextBlock Text="←" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
                <TextBlock Text="Settings" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable settings in a compact two-column layout -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource RoundedScrollViewer}">
            <StackPanel Margin="2,0,2,0">

                <!-- General -->
                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Start on boot" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="StartOnBootCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Hover mode -->
                <TextBlock Text="Hover behavior" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,2"/>
                <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10" Padding="2" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="HoverPeekRadio" Content="Peek + Click"
                                     Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnHoverModeChanged"/>
                        <RadioButton x:Name="LongHoverRadio" Content="Long hover"
                                     Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnHoverModeChanged"/>
                    </Grid>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>

                <!-- Theme selector -->
                <TextBlock Text="Theme" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,2"/>
                <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10" Padding="2" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark"
                                     Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="Light"
                                     Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                    </Grid>
                </Border>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Adapt to Windows theme" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="AdaptToWindowsThemeCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnAdaptThemeChanged" Unchecked="OnAdaptThemeChanged"/>
                </Grid>
                <TextBlock Text="Follows Windows light or dark mode, accent color, and accessibility-friendly contrast live."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Show shadow" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowShadowCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Music -->
                <TextBlock Text="MUSIC" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Music controls" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Audio visualizer" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowVisualizerCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Online lyrics" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="OnlineLyricsCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnOnlineLyricsChanged" Unchecked="OnOnlineLyricsChanged"/>
                </Grid>
                <TextBlock Text="Sends the current track title, artist, album and duration to LRCLIB. Off by default."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>
                <Button Click="OnMediaQueueSettingsClick" HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1,0,6">
                    <TextBlock Text="Configure Spotify / VLC playback queue"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="11" TextDecorations="Underline"/>
                </Button>

                <!-- System HUD -->
                <TextBlock Text="SYSTEM HUD" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Volume HUD" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="VolumeHudCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Brightness HUD" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="BrightnessHudCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Battery & Calendar -->
                <TextBlock Text="WIDGETS" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Battery indicator" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowBatteryCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Calendar panel" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowCalendarCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Webcam mirror" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowWebcamCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2" x:Name="WebcamFpsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mirror FPS" Style="{StaticResource SettingLabel}" Grid.Column="0"/>
                    <Slider x:Name="WebcamFpsSlider" Grid.Column="1"
                            Style="{StaticResource CompactSlider}"
                            Minimum="5" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" Margin="10,0,10,0"
                            ValueChanged="OnWebcamFpsChanged"/>
                    <Border Grid.Column="2" Background="{DynamicResource SegmentedBgBrush}"
                            CornerRadius="6" Padding="6,2" MinWidth="32">
                        <TextBlock x:Name="WebcamFpsLabel"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Screens -->
                <TextBlock Text="SCREENS" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Reserve space at top" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ReserveSpaceCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Claims a dedicated strip at the top of the screen (like the taskbar) so maximized windows start below the notch. Fullscreen apps still cover it."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Island on every screen" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowOnAllScreensCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Shows an island on each connected display. Drag any island to move it between screens."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Synchronize islands" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="SyncIslandsCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Opening or closing one island does the same on all screens. Off = each island acts independently."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <!-- Beta Features -->
                <TextBlock Text="BETA FEATURES" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Liquid Glass Theme" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="LiquidGlassCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnLiquidGlassChanged" Unchecked="OnLiquidGlassChanged"/>
                </Grid>

                <!-- Features -->
                <TextBlock Text="FEATURES" Style="{StaticResource SectionHeader}"/>

                <Button Click="OnManageFeaturesClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4">
                    <TextBlock Text="View feature catalog"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>
                <Button Click="OnCommandBarSettingsClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4">
                    <TextBlock Text="Configure Command Bar"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>
                <Button Click="OnRadialMenuSettingsClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4">
                    <TextBlock Text="Configure Radial Menu"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>
                <Button Click="OnProductHardeningClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4"
                        AutomationProperties.Name="Permissions, backup, and diagnostics">
                    <TextBlock Text="Permissions, backup &amp; diagnostics"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>

                <!-- Clipboard -->
                <TextBlock Text="CLIPBOARD" Style="{StaticResource SectionHeader}"/>
                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Capture images" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ClipboardImagesCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnClipboardSettingsChanged" Unchecked="OnClipboardSettingsChanged"/>
                </Grid>
                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Capture files" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ClipboardFilesCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnClipboardSettingsChanged" Unchecked="OnClipboardSettingsChanged"/>
                </Grid>
                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Ctrl+Shift+V pastes plain text" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ClipboardPlainPasteCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnClipboardSettingsChanged" Unchecked="OnClipboardSettingsChanged"/>
                </Grid>
                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Automatically clean tracking URLs" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ClipboardCleanUrlsCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnClipboardSettingsChanged" Unchecked="OnClipboardSettingsChanged"/>
                </Grid>
                <TextBlock Text="History limit" Style="{StaticResource SettingLabel}" Margin="0,3,0,1"/>
                <Slider x:Name="ClipboardLimitSlider" Minimum="10" Maximum="500" TickFrequency="10"
                        IsSnapToTickEnabled="True" ValueChanged="OnClipboardSettingsChanged"/>
                <TextBlock Text="Ignored process names, separated by commas" Style="{StaticResource SettingLabel}"
                           Margin="0,4,0,1"/>
                <TextBox x:Name="ClipboardIgnoredAppsText" Height="24" FontSize="10"
                         LostFocus="OnClipboardSettingsChanged"/>
                <TextBlock Text="Auto-clear seconds (0 = off)" Style="{StaticResource SettingLabel}"
                           Margin="0,4,0,1"/>
                <Slider x:Name="ClipboardAutoClearSlider" Minimum="0" Maximum="600" TickFrequency="30"
                        IsSnapToTickEnabled="True" ValueChanged="OnClipboardSettingsChanged"/>

                <!-- Downloads -->
                <TextBlock Text="DOWNLOADS" Style="{StaticResource SectionHeader}"/>
                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Download live activity" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="DownloadMonitoringCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnDownloadMonitoringChanged" Unchecked="OnDownloadMonitoringChanged"/>
                </Grid>

                <Button Click="OnChooseDownloadsFolder" HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1,0,2">
                    <TextBlock Text="Choose folder" Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="11" TextDecorations="Underline"/>
                </Button>
                <TextBlock x:Name="DownloadsFolderText" Text="No folder selected"
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                <!-- Plugins -->
                <TextBlock Text="PLUGINS" Style="{StaticResource SectionHeader}"/>

                <Button x:Name="ManagePluginsButton" Click="OnManagePluginsClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4">
                    <TextBlock Text="Manage plugins"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>

                <!-- About -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFaintBrush}" FontSize="10" Text="WinNotch" Margin="0,0,0,2"/>
                <TextBlock Foreground="{DynamicResource TextFaintestBrush}" FontSize="9" Text="Inspired by boring.notch for macOS"
                           Margin="0,0,0,4"/>

                <!-- Update check -->
                <Grid Margin="0,0,0,8">
                    <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick"
                            HorizontalAlignment="Left" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <TextBlock x:Name="CheckUpdateText" Text="Check for updates"
                                   Foreground="{DynamicResource TextSubtleBrush}" FontSize="10"
                                   TextDecorations="Underline"/>
                    </Button>
                    <Button x:Name="UpdateButton" Click="OnUpdateClick"
                            Visibility="Collapsed" HorizontalAlignment="Left"
                            Cursor="Hand" Padding="6,3" Background="{DynamicResource SegmentedCheckedBgBrush}"
                            BorderThickness="0">
                        <TextBlock x:Name="UpdateButtonText" Text="Update available"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
