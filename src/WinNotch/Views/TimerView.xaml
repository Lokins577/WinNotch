<UserControl x:Class="WinNotch.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="88">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SegmentedCheckedBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Border x:Name="RootBorder"
            Background="{DynamicResource SegmentedBgBrush}"
            CornerRadius="10" Padding="10" Margin="0,4,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="FocusModeButton" Content="Focus" Click="OnFocusMode"
                        FontSize="10" Padding="7,2" Margin="0,0,4,0"/>
                <Button x:Name="CountdownModeButton" Content="Timer" Click="OnCountdownMode"
                        FontSize="10" Padding="7,2" Margin="0,0,4,0"/>
                <Button x:Name="StopwatchModeButton" Content="Stopwatch" Click="OnStopwatchMode"
                        FontSize="10" Padding="7,2"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,6,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PhaseText" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TimeText" Text="25:00" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel x:Name="CountdownAdjustments" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Content="−" Click="OnSubtractMinute" Width="24" Height="24" Margin="0,0,4,0"/>
                    <Button Content="+" Click="OnAddMinute" Width="24" Height="24"/>
                </StackPanel>
                <TextBlock x:Name="SessionText" Grid.Column="1" VerticalAlignment="Center"
                           FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button x:Name="StartPauseButton" Content="Start" Click="OnStartPause"
                        Padding="10,3" Margin="0,0,5,0"/>
                <Button Content="Reset" Click="OnReset" Padding="8,3" Margin="0,0,5,0"/>
                <Button x:Name="SkipButton" Content="Skip" Click="OnSkip" Padding="8,3"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
