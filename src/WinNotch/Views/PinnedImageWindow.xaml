<Window x:Class="WinNotch.Views.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="320" MinWidth="120" MinHeight="80"
        WindowStyle="ToolWindow" ShowInTaskbar="False" Topmost="True"
        Title="Pinned capture" Background="#111">
    <Grid>
        <Image x:Name="PinnedImage" Stretch="Uniform"/>
        <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="6" Click="OnClose" AutomationProperties.Name="Close pinned capture"/>
    </Grid>
</Window>
