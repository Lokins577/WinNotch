<Window x:Class="WinNotch.Views.RadialMenuSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radial Menu Settings" Width="680" Height="470"
        MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Pointer-centered radial menu" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Press Ctrl+Alt+R. Add up to 12 typed actions; arbitrary command text is never executed."
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="ItemList" DisplayMemberPath="Label"
                         SelectionChanged="OnItemSelected"/>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="New" Click="OnNew" Padding="10,4"/>
                    <Button Content="Delete" Click="OnDelete" Padding="10,4" Margin="6,0,0,0"/>
                    <Button Content="↑" ToolTip="Move up" Click="OnMoveUp" Padding="10,4" Margin="6,0,0,0"/>
                    <Button Content="↓" ToolTip="Move down" Click="OnMoveDown" Padding="10,4" Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Label" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="LabelText" MaxLength="32" Margin="0,3,0,10"/>

                <TextBlock Text="Action" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="KindBox" Margin="0,3,0,10"
                          SelectionChanged="OnKindChanged"/>

                <TextBlock x:Name="TargetLabel" Text="Target"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="TargetText" Margin="0,3,0,8"/>
                <WrapPanel x:Name="BrowsePanel" Margin="0,0,0,10">
                    <Button Content="Choose file" Click="OnChooseFile" Padding="10,4"/>
                    <Button x:Name="ChooseFolderButton" Content="Choose folder"
                            Click="OnChooseFolder" Padding="10,4" Margin="6,0,0,0"/>
                </WrapPanel>

                <TextBlock x:Name="ActionHint" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextSubtleBrush}"/>
                <Button Content="Save action" Click="OnSave" Padding="12,5"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Content="Restore defaults" Click="OnRestoreDefaults" Padding="10,4"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
