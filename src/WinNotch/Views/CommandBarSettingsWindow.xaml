<Window x:Class="WinNotch.Views.CommandBarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Bar Settings" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="File search">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="FolderList"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add folder" Click="OnAddFolder" Padding="10,4"/>
                        <Button Content="Remove" Click="OnRemoveFolder" Padding="10,4" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Snippets">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="SnippetList" DisplayMemberPath="Name" SelectionChanged="OnSnippetSelected"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Name"/><TextBox x:Name="SnippetName" Margin="0,2,0,6"/>
                        <TextBlock Text="Trigger"/><TextBox x:Name="SnippetTrigger" Margin="0,2,0,6"/>
                        <TextBlock Text="Content"/><TextBox x:Name="SnippetContent" Height="230"
                            AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="New" Click="OnNewSnippet" Padding="10,4"/>
                            <Button Content="Save" Click="OnSaveSnippet" Padding="10,4" Margin="6,0,0,0"/>
                            <Button Content="Delete" Click="OnDeleteSnippet" Padding="10,4" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Scripts">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="ScriptList" DisplayMemberPath="Name" SelectionChanged="OnScriptSelected"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Name"/><TextBox x:Name="ScriptName" Margin="0,2,0,6"/>
                        <TextBlock Text="Executable"/>
                        <DockPanel Margin="0,2,0,6">
                            <Button DockPanel.Dock="Right" Content="Browse" Click="OnBrowseExecutable" Padding="8,2"/>
                            <TextBox x:Name="ScriptExecutable" Margin="0,0,6,0"/>
                        </DockPanel>
                        <TextBlock Text="Arguments"/><TextBox x:Name="ScriptArguments" Margin="0,2,0,6"/>
                        <TextBlock Text="Working directory (optional)"/><TextBox x:Name="ScriptWorkingDirectory" Margin="0,2,0,8"/>
                        <TextBlock Text="Scripts run only after selection from a query beginning with &gt;."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="New" Click="OnNewScript" Padding="10,4"/>
                            <Button Content="Save" Click="OnSaveScript" Padding="10,4" Margin="6,0,0,0"/>
                            <Button Content="Delete" Click="OnDeleteScript" Padding="10,4" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
