<UserControl x:Class="WinNotch.Views.MusicPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:WinNotch.Views.Components">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/MarqueeTextStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TransportHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TransportPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Album art with glow -->
        <Grid x:Name="AlbumArtGrid" Grid.Column="0" Margin="0,0,12,0">
            <!-- Background glow from album art -->
            <Border x:Name="AlbumGlow"
                    Width="90" Height="90"
                    CornerRadius="14"
                    Opacity="0.4">
                <Border.Background>
                    <ImageBrush x:Name="GlowBrush" Stretch="UniformToFill"/>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="24"/>
                </Border.Effect>
            </Border>

            <!-- Album art -->
            <Border Width="90" Height="90"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Image x:Name="AlbumArtImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- Right side: info + controls -->
        <Grid x:Name="InfoControlsGrid" Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Song title (marquee) -->
            <comp:MarqueeText x:Name="TitleText"
                              Grid.Row="0"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Height="22"
                              Margin="0,0,0,1"/>

            <!-- Artist -->
            <comp:MarqueeText x:Name="ArtistText"
                              Grid.Row="1"
                              FontSize="11"
                              FontWeight="Normal"
                              Foreground="{DynamicResource TextTertiaryBrush}"
                              Height="17"
                              Margin="0,0,0,5"/>

            <!-- Progress bar -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ElapsedText"
                           Grid.Column="0"
                           Text="0:00"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <Border Grid.Column="1"
                        Height="4"
                        CornerRadius="2"
                        Background="{DynamicResource ProgressTrackBrush}"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnProgressBarClick">
                    <Border x:Name="ProgressFill"
                            Height="4"
                            CornerRadius="2"
                            Background="{DynamicResource ProgressFillBrush}"
                            HorizontalAlignment="Left"/>
                </Border>

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="0:00"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
            </Grid>

            <!-- Transport controls -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- Shuffle -->
                <Button x:Name="ShuffleButton"
                        Click="OnShuffleClick"
                        Style="{StaticResource TransportButton}"
                        Margin="0,0,8,0"
                        ToolTip="Shuffle">
                    <TextBlock Text="🔀" FontSize="13"/>
                </Button>

                <!-- Previous -->
                <Button x:Name="PrevButton"
                        Click="OnPrevClick"
                        Style="{StaticResource TransportButton}"
                        Margin="0,0,6,0"
                        ToolTip="Previous">
                    <TextBlock Text="⏮" FontSize="16"/>
                </Button>

                <!-- Play/Pause -->
                <Button x:Name="PlayPauseButton"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource TransportButton}"
                        Width="32" Height="32"
                        ToolTip="Play/Pause">
                    <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="16"/>
                </Button>

                <!-- Next -->
                <Button x:Name="NextButton"
                        Click="OnNextClick"
                        Style="{StaticResource TransportButton}"
                        Margin="6,0,0,0"
                        ToolTip="Next">
                    <TextBlock Text="⏭" FontSize="16"/>
                </Button>

                <!-- Repeat -->
                <Button x:Name="RepeatButton"
                        Click="OnRepeatClick"
                        Style="{StaticResource TransportButton}"
                        Margin="8,0,0,0"
                        ToolTip="Repeat">
                    <TextBlock x:Name="RepeatIcon" Text="🔁" FontSize="13"/>
                </Button>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceCombo" Width="105" Height="22"
                          FontSize="9" Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          SelectionChanged="OnSourceSelectionChanged"/>
                <TextBlock x:Name="LyricsText" Grid.Column="1" FontSize="10"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Grid>

        <!-- No media placeholder -->
        <TextBlock x:Name="NoMediaText"
                   Grid.ColumnSpan="2"
                   Text="No music playing"
                   Foreground="{DynamicResource TextFaintBrush}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
