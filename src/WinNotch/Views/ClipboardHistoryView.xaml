<UserControl x:Class="WinNotch.Views.ClipboardHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10"
            Padding="10" Margin="0,4,0,0">
        <StackPanel>
            <Grid>
                <TextBlock Text="Clipboard" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="Clear" Click="OnClear" HorizontalAlignment="Right"
                        Padding="7,2" FontSize="9"/>
            </Grid>
            <TextBox x:Name="SearchBox" Margin="0,6,0,4" Height="24" FontSize="10"
                     TextChanged="OnSearchChanged" ToolTip="Search clipboard history"/>
            <TextBlock x:Name="EmptyText" Text="Copy text, images or files to build history."
                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel x:Name="ItemHost"/>
        </StackPanel>
    </Border>
</UserControl>
