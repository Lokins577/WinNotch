<UserControl x:Class="WinNotch.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Separator + header -->
        <Grid Grid.Row="0" Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Shelf"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="ItemCountText"
                       Grid.Column="1"
                       FontSize="9"
                       Foreground="{DynamicResource TextFaintBrush}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"/>

            <Button x:Name="ClearAllButton"
                    Grid.Column="2"
                    Click="OnClearAllClick"
                    Cursor="Hand"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,1" VerticalAlignment="Center">
                <TextBlock Text="Clear" FontSize="9"
                           Foreground="{DynamicResource TextSubtleBrush}"/>
            </Button>
        </Grid>

        <!-- File items scroll area -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      PanningMode="HorizontalOnly">
            <ItemsControl x:Name="ShelfItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder"
                                Width="62" Margin="2,0"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="4,4"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnItemMouseDown"
                                MouseRightButtonDown="OnItemRightClick"
                                MouseMove="OnItemMouseMove"
                                ToolTip="{Binding FilePath}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="32" Height="32"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="58"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding PinMarker}" FontSize="8"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Drop zone overlay (shown when dragging files over the notch) -->
        <Border x:Name="DropZoneOverlay"
                Grid.RowSpan="2"
                CornerRadius="8"
                Background="{DynamicResource DropZoneBrush}"
                BorderBrush="{DynamicResource TextSubtleBrush}"
                BorderThickness="1.5"
                Visibility="Collapsed">
            <Border.Effect>
                <BlurEffect Radius="0"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock Text="Drop files here"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Empty state (when no items and not dragging) -->
        <Border x:Name="EmptyState"
                Grid.RowSpan="2"
                Visibility="Collapsed">
            <TextBlock Text="Drag files onto the notch to shelf them"
                       FontSize="10"
                       Foreground="{DynamicResource TextFaintBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</UserControl>
