<Window x:Class="WinNotch.Views.RegionCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#44000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Cursor="Cross"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp" PreviewKeyDown="OnKeyDown">
    <Canvas>
        <Rectangle x:Name="Selection" Stroke="#FF4FA3FF" StrokeThickness="2"
                   Fill="#224FA3FF" Visibility="Collapsed"/>
        <TextBlock Text="Drag to capture · Esc to cancel" Foreground="White"
                   Background="#99000000" Padding="10,6" Canvas.Left="18" Canvas.Top="18"/>
    </Canvas>
</Window>
