<Window x:Class="WinNotch.Views.CaptureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Editor" Width="1050" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Crop" Tag="Crop" Click="OnMode"/>
            <Button Content="Redact" Tag="Redact" Click="OnMode"/>
            <Button Content="Draw" Tag="Draw" Click="OnMode"/>
            <Button Content="Color" Tag="Color" Click="OnMode"/>
            <Separator/>
            <Button Content="OCR" Click="OnOcr"/>
            <Button Content="QR" Click="OnQr"/>
            <Button Content="Copy" Click="OnCopy"/>
            <Button Content="Save" Click="OnSave"/>
            <Button Content="Pin" Click="OnPin"/>
            <Button Content="Reset" Click="OnReset"/>
        </ToolBar>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Padding="10,6"
                   Text="Choose a tool, then drag or click the image."/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#222">
            <Canvas x:Name="ImageCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="CaptureImage" Stretch="None"
                       MouseLeftButtonDown="OnImageMouseDown"
                       MouseMove="OnImageMouseMove"
                       MouseLeftButtonUp="OnImageMouseUp"/>
                <Rectangle x:Name="Selection" Stroke="#FF4FA3FF" StrokeThickness="2"
                           Fill="#334FA3FF" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Canvas>
        </ScrollViewer>
    </DockPanel>
</Window>
