<Window x:Class="WinNotch.Views.ProductHardeningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permissions, Backup &amp; Diagnostics" Width="760" Height="620" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.Name="WinNotch permissions, backup, and diagnostics">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Product Hardening" FontSize="20" FontWeight="SemiBold"/>
        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Permissions"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PermissionHost" Margin="10"/></ScrollViewer></TabItem>
            <TabItem Header="Settings &amp; language">
                <StackPanel Margin="12">
                    <TextBlock Text="Language"/><ComboBox x:Name="LanguageBox" Margin="0,4,0,10"/>
                    <TextBlock Text="Changing language takes effect fully after restart." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <WrapPanel Margin="0,14,0,0"><Button Content="Export settings" Click="OnExport" Padding="10,5" AutomationProperties.Name="Export settings backup"/><Button Content="Import settings" Click="OnImport" Padding="10,5" Margin="8,0,0,0" AutomationProperties.Name="Import settings backup"/></WrapPanel>
                    <TextBlock Text="Exports contain local paths, snippets, and saved script arguments. Treat the backup as private because user-entered arguments can contain sensitive text." TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="Installer migration" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MigrationText" TextWrapping="Wrap" Margin="0,5,0,5"/>
                    <Button x:Name="LegacyUninstallButton" Content="Remove legacy Inno installation…" Click="OnLegacyUninstall" HorizontalAlignment="Left" Padding="10,5"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Diagnostics">
                <StackPanel Margin="12">
                    <CheckBox x:Name="CrashReportsCheck" Content="Keep local crash reports (maximum 20)"/>
                    <CheckBox x:Name="PerformanceCheck" Content="Monitor sustained performance-budget violations" Margin="0,8,0,0"/>
                    <TextBlock x:Name="PerformanceText" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Budgets: UI latency 250 ms, background CPU 20%, working set 450 MiB. Violations are local diagnostics and are never uploaded." TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Button Content="Open crash report folder" Click="OnOpenCrashFolder" HorizontalAlignment="Left" Padding="10,5"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Save" Click="OnSave" Padding="12,5"/></StackPanel>
    </Grid>
</Window>
