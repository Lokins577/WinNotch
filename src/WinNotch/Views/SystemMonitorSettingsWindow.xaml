<Window x:Class="WinNotch.Views.SystemMonitorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Monitor Alert Settings" Width="480" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="Sampling and sustained alerts" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Alerts fire once after a metric remains above its threshold, then re-arm only after recovery."
                   Margin="0,5,0,14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <DockPanel><TextBlock Text="Sample interval (seconds)"/><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=IntervalSlider, Path=Value, StringFormat={}{0:0}}"/></DockPanel>
        <Slider x:Name="IntervalSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"/>
        <DockPanel Margin="0,10,0,0"><TextBlock Text="Sustained duration (seconds)"/><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:0}}"/></DockPanel>
        <Slider x:Name="DurationSlider" Minimum="2" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"/>

        <CheckBox x:Name="CpuEnabled" Content="CPU alert" Margin="0,14,0,0"/>
        <Slider x:Name="CpuSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Value}"/>
        <CheckBox x:Name="MemoryEnabled" Content="Memory alert" Margin="0,10,0,0"/>
        <Slider x:Name="MemorySlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Value}"/>
        <CheckBox x:Name="GpuEnabled" Content="GPU alert (estimated when available)" Margin="0,10,0,0"/>
        <Slider x:Name="GpuSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Value}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="OnCancel" Padding="12,5"/>
            <Button Content="Save" Click="OnSave" Padding="12,5" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
