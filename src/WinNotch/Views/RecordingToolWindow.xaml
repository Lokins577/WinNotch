<Window x:Class="WinNotch.Views.RecordingToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording &amp; Media Tools" Width="560" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="Recording &amp; Media Tools" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Ctrl+Alt+V · local frame project with separate WAV tracks" FontSize="10"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14"/>
        <TextBlock Text="Display"/><ComboBox x:Name="ScreenBox" DisplayMemberPath="DeviceName" Margin="0,3,0,8"/>
        <DockPanel><TextBlock Text="Frames per second"/><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=FpsSlider, Path=Value, StringFormat={}{0:0}}"/></DockPanel>
        <Slider x:Name="FpsSlider" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
            <CheckBox x:Name="SystemAudioCheck" Content="System audio" Margin="0,0,18,0"/>
            <CheckBox x:Name="MicrophoneCheck" Content="Microphone"/>
        </StackPanel>
        <WrapPanel>
            <Button x:Name="StartDisplayButton" Content="Record display" Click="OnStartDisplay" Padding="12,6"/>
            <Button x:Name="StartRegionButton" Content="Record region…" Click="OnStartRegion" Padding="12,6" Margin="8,0,0,0"/>
            <Button x:Name="StopButton" Content="Stop" Click="OnStop" Padding="12,6" Margin="8,0,0,0" IsEnabled="False"/>
            <Button Content="Image tools…" Click="OnImageTools" Padding="12,6" Margin="8,0,0,0"/>
        </WrapPanel>
        <ProgressBar x:Name="RecordingProgress" Height="8" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</Window>
