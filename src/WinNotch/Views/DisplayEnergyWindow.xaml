<Window x:Class="WinNotch.Views.DisplayEnergyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display, Energy &amp; Hardware" Width="680" Height="650" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Display, Energy &amp; Hardware" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ctrl+Alt+E · hardware writes require explicit capability and validation" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="KEEP AWAKE" FontSize="10" FontWeight="SemiBold"/>
                <ComboBox x:Name="KeepAwakeBox" Margin="0,4,0,4"/>
                <WrapPanel><CheckBox x:Name="FullscreenCheck" Content="While fullscreen" Margin="0,4,18,0"/><CheckBox x:Name="RecordingCheck" Content="While recording" Margin="0,4,0,0"/></WrapPanel>

                <TextBlock Text="BRIGHTNESS &amp; DIMMING" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <WrapPanel Margin="0,4,0,0"><Button Content="Brightness −" Click="OnBrightnessDown" Padding="9,4"/><Button Content="Brightness +" Click="OnBrightnessUp" Padding="9,4" Margin="6,0,0,0"/><TextBlock Text="Step" VerticalAlignment="Center" Margin="14,0,5,0"/><TextBox x:Name="StepText" Width="45"/></WrapPanel>
                <DockPanel Margin="0,8,0,2"><TextBlock Text="Software dimming"/><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DimmingSlider, Path=Value, StringFormat={}{0:P0}}"/></DockPanel>
                <Slider x:Name="DimmingSlider" Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                <TextBlock Text="EXTERNAL DDC/CI MONITORS" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock Text="Only enable writes after physically confirming brightness control works on that exact monitor." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="MonitorHost" Margin="0,6,0,0"/>

                <TextBlock Text="SLEEP BLUETOOTH POLICY" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <ComboBox x:Name="BluetoothBox"/>
                <TextBlock x:Name="BluetoothStatusText" Margin="0,4,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="HARDWARE PROVIDERS" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock x:Name="TemperatureText" TextWrapping="Wrap"/>
                <TextBlock x:Name="FanText" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Refresh hardware" Click="OnRefresh" Padding="10,5"/><Button Content="Save" Click="OnSave" Padding="12,5" Margin="8,0,0,0"/></StackPanel>
    </Grid>
</Window>
