<Window x:Class="WinNotch.Views.ImageToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Tools" Width="520" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="Convert, compress &amp; watermark images" FontSize="18" FontWeight="SemiBold"/>
        <Button Content="Choose images…" Click="OnChooseFiles" HorizontalAlignment="Left" Padding="10,5" Margin="0,14,0,4"/>
        <TextBlock x:Name="FilesText" Text="No files selected" TextWrapping="Wrap"/>
        <TextBlock Text="Output format" Margin="0,12,0,3"/>
        <ComboBox x:Name="FormatBox" SelectedIndex="0"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEG"/></ComboBox>
        <TextBlock Text="Maximum dimension (0 = keep size)" Margin="0,10,0,3"/><TextBox x:Name="MaxDimensionText" Text="0"/>
        <TextBlock Text="JPEG quality" Margin="0,10,0,3"/><Slider x:Name="QualitySlider" Minimum="20" Maximum="100" Value="88" TickFrequency="1"/>
        <TextBlock Text="Watermark (optional)" Margin="0,10,0,3"/><TextBox x:Name="WatermarkText"/>
        <Button Content="Convert…" Click="OnConvert" HorizontalAlignment="Left" Padding="12,5" Margin="0,14,0,0"/>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
