<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WinNotch</RootNamespace>
    <AssemblyName>WinNotch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- App metadata -->
    <ApplicationIcon>Assets\Icons\WinNotch.ico</ApplicationIcon>
    <Version>$(WinNotchVersion)</Version>
    <FileVersion>$(WinNotchVersion).0</FileVersion>
    <AssemblyVersion>$(WinNotchVersion).0</AssemblyVersion>
    <Product>WinNotch</Product>
    <Description>Dynamic Island-inspired notch overlay for Windows</Description>
    <Company>N3uralCreativity</Company>
    <Copyright>Copyright © 2026 N3uralCreativity. Licensed under GPL-3.0.</Copyright>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Publish settings (applied only via: dotnet publish -c Release) -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Keep restore configuration-independent so Release project references
         can resolve the runtime-specific app assets in solution builds. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinNotch.Core\WinNotch.Core.csproj" />
    <ProjectReference Include="..\WinNotch.Platform.Windows\WinNotch.Platform.Windows.csproj" />
    <ProjectReference Include="..\WinNotch.PluginSdk\WinNotch.PluginSdk.csproj" />
    <ProjectReference Include="..\WinNotch.PluginHost\WinNotch.PluginHost.csproj" />
  </ItemGroup>

</Project>
